# Copy to .env.local (git ignores *.local) and fill in from the Supabase dashboard:
# Project Settings -> API. The anon key is meant to be public, but keep it out of git anyway.
# Vite bakes these in at build time, so after changing them in Vercel, redeploy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
